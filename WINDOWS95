local musicSound = make("Sound", { Name = "Win95Music", Looped = true, Volume = 0.5 }, SoundService)

local function openMusic()
	local w = createWindow("music", 262, 200, function()
		musicSound:Stop()
	end)
	local body = w.body
	local idF = field(body, 0, 0, 250, 22)
	local idBox = make("TextBox", {
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -8, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		ClearTextOnFocus = false,
		Font = CODE,
		TextSize = 13,
		TextColor3 = BLACK,
		TextXAlignment = LEFT,
		PlaceholderColor3 = DGREY,
	}, idF)
	trFn(idBox, function()
		idBox.PlaceholderText = T("idHint")
	end)

	local status = lbl(body, "", 0, 60, 250, 16)
	local seekLock = 0
	local seek = slider(body, 0, 84, 250, 0, function(v)
		if musicSound.TimeLength > 0 then
			musicSound.TimePosition = v * musicSound.TimeLength
		end
		seekLock = os.clock() + 0.4
	end)
	tr(lbl(body, "", 0, 108, 250, 14), "volume")
	slider(body, 0, 126, 250, 0.25, function(v)
		musicSound.Volume = v * 2
	end)

	local function play()
		local id = idBox.Text:match("%d+")
		if not id then
			status.Text = T("invalidId")
			sfx(SND.err)
			return
		end
		musicSound.SoundId = "rbxassetid://" .. id
		musicSound:Play()
		status.Text = T("playing") .. " " .. id
	end
	local function stop()
		musicSound:Stop()
		status.Text = T("stopped")
	end

	btn(body, "", 0, 30, 80, 24, "play").MouseButton1Click:Connect(play)
	btn(body, "", 86, 30, 80, 24, "stop").MouseButton1Click:Connect(stop)

	onTick(w, function()
		if musicSound.IsPlaying and musicSound.TimeLength > 0 and os.clock() > seekLock then
			seek.set(musicSound.TimePosition / musicSound.TimeLength)
		end
	end)
end

