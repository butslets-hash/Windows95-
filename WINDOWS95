					TextSize = 14,
					TextColor3 = isRed(cd) and RED or BLACK,
					Text = RANKS[cd.r] .. SUITS[cd.s],
					ZIndex = 4,
				}, b)
			else
				make("Frame", {
					Position = UDim2.fromOffset(4, 4),
					Size = UDim2.fromOffset(CW - 8, CH - 8),
					BackgroundColor3 = DGREY,
					BorderSizePixel = 0,
					ZIndex = 4,
				}, b)
			end
			if selected then
				make("UIStroke", { Color = YELLOW, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
			end
			b.MouseButton1Click:Connect(onClick)
			return b
		end

		local function slot(parent, x, y, text, onClick)
			local b = make("TextButton", {
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(CW, CH),
				BackgroundColor3 = Color3.fromRGB(0, 96, 0),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Font = CODE,
				TextSize = 14,
				TextColor3 = WHITE,
				Text = text or "",
				ZIndex = 2,
			}, parent)
			bevel(b, true)
			b.MouseButton1Click:Connect(onClick or noop)
			return b
		end

		render = function()
			for _, ch in ipairs(layer:GetChildren()) do
				ch:Destroy()
			end

			if #stock > 0 then
				cardBtn(layer, colX(1), 4, { up = false }, drawStock, false)
			else
				slot(layer, colX(1), 4, T("recycle"), drawStock)
			end
			if #waste > 0 then
				cardBtn(layer, colX(2), 4, waste[#waste], clickWaste, sel ~= nil and sel.kind == "waste")
			else
				slot(layer, colX(2), 4, "", nil)
			end

			for s = 1, 4 do
				local x = colX(3 + s)
				if #found[s] > 0 then
					cardBtn(layer, x, 4, found[s][#found[s]], function()
						clickFound(s)
					end, false)
				else
					slot(layer, x, 4, SUITS[s], function()
						clickFound(s)
					end)
				end
			end

			for c = 1, 7 do
				local x = colX(c)
				local hit = make("TextButton", {
					Position = UDim2.fromOffset(x, 60),
					Size = UDim2.fromOffset(CW, 240),
					BackgroundTransparency = 1,
					AutoButtonColor = false,
					Text = "",
					ZIndex = 1,
				}, layer)
				hit.MouseButton1Click:Connect(function()
					clickCol(c)
				end)
				if #cols[c] == 0 then
					local empty = make("Frame", {
						Position = UDim2.fromOffset(x, 60),
						Size = UDim2.fromOffset(CW, CH),
						BackgroundColor3 = Color3.fromRGB(0, 96, 0),
						BorderSizePixel = 0,
						ZIndex = 2,
					}, layer)
					bevel(empty, true)
				end
				local y = 60
				for i, cd in ipairs(cols[c]) do
					local ii = i
					local isSel = sel ~= nil and sel.kind == "tab" and sel.col == c and i >= sel.idx
					cardBtn(layer, x, y, cd, function()
						clickCard(c, ii)
					end, isSel)
					y = y + (cd.up and 13 or 5)
				end
			end

			local total = #found[1] + #found[2] + #found[3] + #found[4]
			status.Text = total == 52 and T("won") or ""
		end

		local function deal()
			local deck = {}
			for s = 1, 4 do
				for r = 1, 13 do
					table.insert(deck, { r = r, s = s, up = false })
				end
			end
			for i = #deck, 2, -1 do
				local j = math.random(i)
				deck[i], deck[j] = deck[j], deck[i]
			end
			stock, waste, found, cols = {}, {}, { {}, {}, {}, {} }, { {}, {}, {}, {}, {}, {}, {} }
			sel = nil
			local k = 1
			for c = 1, 7 do
				for i = 1, c do
					local cd = deck[k]
					k = k + 1
					cd.up = (i == c)
					table.insert(cols[c], cd)
				end
			end
			for i = k, 52 do
				local cd = deck[i]
				cd.up = false
				table.insert(stock, cd)
			end
			render()
		end

		deal()
		newB.MouseButton1Click:Connect(deal)
	end

	local function openPinball()
		local w = createWindow("pinball", 260, 340)
		local body = w.body

		local board = make("Frame", {
			Size = UDim2.new(1, 0, 1, -30),
			BackgroundColor3 = Color3.fromRGB(20, 20, 30),
			BorderSizePixel = 0,
		}, body)
		bevel(board, true)

		local score, balls = 0, 3
		local scoreL = lbl(body, T("pinScore") .. "0", 4, 314, 120, 16)
		local ballsL = lbl(body, T("pinBalls") .. "3", 130, 314, 80, 16)

		local bx, by, vx, vy = 120, 260, 0, 0
		local ballF = make("Frame", {
			Position = UDim2.fromOffset(bx, by),
			Size = UDim2.fromOffset(10, 10),
			BackgroundColor3 = YELLOW,
			BorderSizePixel = 0,
		}, board)
		make("UICorner", { CornerRadius = UDim.new(1, 0) }, ballF)

		local launched = false
		local launchB = btn(body, "", 210, 312, 68, 22, "pinLaunch")

		local bumpers = {
			{ x = 70,  y = 80,  r = 14 },
			{ x = 130, y = 60,  r = 14 },
			{ x = 180, y = 90,  r = 14 },
			{ x = 100, y = 140, r = 16 },
			{ x = 160, y = 150, r = 16 },
		}
		for _, b in ipairs(bumpers) do
			local bf = make("Frame", {
				Position = UDim2.fromOffset(b.x - b.r, b.y - b.r),
				Size = UDim2.fromOffset(b.r * 2, b.r * 2),
				BackgroundColor3 = RED,
				BorderSizePixel = 0,
			}, board)
			make("UICorner", { CornerRadius = UDim.new(1, 0) }, bf)
		end

		launchB.MouseButton1Click:Connect(function()
			if not launched and balls > 0 then
				launched = true
				vy = -14
				vx = math.random(-2, 2)
				sfx(SND.click, 0.4)
			end
		end)

		local dead = false
		onTick(w, function(dt)
			if not launched or dead then
				return
			end
			vy = vy + 0.35
			bx = bx + vx
			by = by + vy

			if bx < 4 then
				bx = 4
				vx = -vx * 0.8
			elseif bx > 246 then
				bx = 246
				vx = -vx * 0.8
			end
			if by < 4 then
				by = 4
				vy = -vy * 0.8
			end

			for _, b in ipairs(bumpers) do
				local dx, dy = bx - b.x, by - b.y
				local dist = math.sqrt(dx * dx + dy * dy)
				if dist < b.r + 5 then
					local nx, ny = dx / dist, dy / dist
					vx = nx * 8 + math.random(-1, 1)
					vy = ny * 8 + math.random(-1, 1)
					score = score + 100
					scoreL.Text = T("pinScore") .. score
					sfx(SND.ok, 0.3)
				end
			end

			if by > 300 then
				balls = balls - 1
				ballsL.Text = T("pinBalls") .. balls
				launched = false
				bx, by, vx, vy = 230, 260, 0, 0
				ballF.Position = UDim2.fromOffset(bx, by)
				if balls <= 0 then
					dead = true
					scoreL.Text = T("pinScore") .. score .. T("pinOver")
				end
				return
			end

			ballF.Position = UDim2.fromOffset(bx, by)
		end)
	end

	table.insert(APPS, { key = "solitaire", glyph = "S", color = Color3.fromRGB(255, 255, 255), open = openSolitaire })
	table.insert(APPS, { key = "pinball", glyph = "F", color = Color3.fromRGB(255, 100, 200), open = openPinball })
end

