local function openMines()
	local N, MINES, CS = 9, 10, 22
	local w = createWindow("mines", 250, 262)
	local body = w.body
	local cells, st, mines = {}, {}, {}
	local flagMode, gameOver, opened = false, false, 0
	local COL = {
		Color3.fromRGB(0, 0, 255), Color3.fromRGB(0, 128, 0), Color3.fromRGB(255, 0, 0), NAVY,
		Color3.fromRGB(128, 0, 0), Color3.fromRGB(0, 128, 128), BLACK, DGREY,
	}

	local flagB = btn(body, "", 0, 0, 120, 22)
	local faceB = btn(body, ":)", 126, 0, 30, 22)
	local info = lbl(body, "", 160, 3, 80, 16)

	local function isMine(r, c)
		return mines[r * 100 + c] == true
	end
	local function nearby(r, c)
		local n = 0
		for dr = -1, 1 do
			for dc = -1, 1 do
				local rr, cc = r + dr, c + dc
				if (dr ~= 0 or dc ~= 0) and rr >= 1 and rr <= N and cc >= 1 and cc <= N and isMine(rr, cc) then
					n = n + 1
				end
			end
		end
		return n
	end
	local function updInfo()
		local f = 0
		for r = 1, N do
			for c = 1, N do
				if st[r][c] == 2 then
					f = f + 1
				end
			end
		end
		info.Text = T("minesLeft") .. (MINES - f)
	end
	local function drawOpen(r, c)
		local b = cells[r][c]
		b:ClearAllChildren()
		bevel(b, true)
		b.BackgroundColor3 = GREY
	end
	local function reveal(r, c)
		if r < 1 or r > N or c < 1 or c > N or st[r][c] ~= 0 then
			return
		end
		st[r][c] = 1
		opened = opened + 1
		drawOpen(r, c)
		local n = nearby(r, c)
		if n > 0 then
			cells[r][c].Text = tostring(n)
			cells[r][c].TextColor3 = COL[n]
		else
			for dr = -1, 1 do
				for dc = -1, 1 do
					reveal(r + dr, c + dc)
				end
			end
		end
	end
	local function endGame(won)
		gameOver = true
		faceB.Text = won and "BJ" or "X("
		if not won then
			for r = 1, N do
				for c = 1, N do
					if isMine(r, c) and st[r][c] ~= 2 then
						drawOpen(r, c)
						cells[r][c].Text = "*"
					end
				end
			end
		end
		sfx(won and SND.ok or SND.err, 0.5)
		info.Text = T(won and "won" or "lost")
	end
	local function toggleFlag(r, c)
		if gameOver or st[r][c] == 1 then
			return
		end
		if st[r][c] == 0 then
			st[r][c] = 2
			cells[r][c].Text = "F"
			cells[r][c].TextColor3 = Color3.fromRGB(255, 0, 0)
		else
			st[r][c] = 0
			cells[r][c].Text = ""
		end
		updInfo()
	end
	local function onCell(r, c)
		if gameOver then
			return
		end
		if flagMode then
			toggleFlag(r, c)
			return
		end
		if st[r][c] ~= 0 then
			return
		end
		if isMine(r, c) then
			st[r][c] = 1
			endGame(false)
		else
			reveal(r, c)
			if opened == N * N - MINES then
				endGame(true)
			end
		end
	end

	local board = make("Frame", {
		Position = UDim2.fromOffset(22, 28),
		Size = UDim2.fromOffset(N * CS, N * CS),
		BackgroundTransparency = 1,
	}, body)
	for r = 1, N do
		cells[r] = {}
		for c = 1, N do
			local b = make("TextButton", {
				Position = UDim2.fromOffset((c - 1) * CS, (r - 1) * CS),
				Size = UDim2.fromOffset(CS, CS),
				BackgroundColor3 = GREY,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Font = FONT,
				TextSize = 12,
				TextColor3 = BLACK,
				Text = "",
			}, board)
			cells[r][c] = b
			b.MouseButton1Click:Connect(function()
				onCell(r, c)
			end)
			b.MouseButton2Click:Connect(function()
				toggleFlag(r, c)
			end)
		end
	end

	local function newGame()
		gameOver, opened, mines = false, 0, {}
		faceB.Text = ":)"
		local placed = 0
		while placed < MINES do
			local r, c = math.random(1, N), math.random(1, N)
			if not isMine(r, c) then
				mines[r * 100 + c] = true
				placed = placed + 1
			end
		end
		for r = 1, N do
			st[r] = {}
			for c = 1, N do
				st[r][c] = 0
				local b = cells[r][c]
				b:ClearAllChildren()
				bevel(b, false)
				b.Text = ""
				b.BackgroundColor3 = GREY
			end
		end
		updInfo()
	end

	local function refreshFlag()
		flagB.Text = T("flag") .. (flagMode and "ON" or "OFF")
	end
	trFn(flagB, refreshFlag)
	flagB.MouseButton1Click:Connect(function()
		flagMode = not flagMode
		refreshFlag()
	end)
	faceB.MouseButton1Click:Connect(newGame)
	newGame()
end

