local function createWindow(key, w, h, onClose)
	local n = #wins
	local f = make("Frame", {
		Position = UDim2.fromOffset(30 + (n * 24) % 120, 20 + (n * 24) % 100),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = GREY,
		BorderSizePixel = 0,
		ZIndex = 10,
	}, DESK)
	bevel(f, false)

	local bar = make("Frame", {
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 0, 18),
		BackgroundColor3 = DGREY,
		BorderSizePixel = 0,
	}, f)
	local title = make("TextLabel", {
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -44, 1, 0),
		BackgroundTransparency = 1,
		TextColor3 = WHITE,
		Font = FONT,
		TextSize = 11,
		TextXAlignment = LEFT,
		TextTruncate = TRUNC,
	}, bar)
	tr(title, key)
	local minB = tbBtn(bar, "_", UDim2.new(1, -37, 0, 2))
	local closeB = tbBtn(bar, "X", UDim2.new(1, -19, 0, 2))

	local body = make("Frame", {
		Position = UDim2.fromOffset(4, 25),
		Size = UDim2.fromOffset(w - 8, h - 29),
		BackgroundTransparency = 1,
	}, f)

	local tb = make("TextButton", {
		Size = UDim2.fromOffset(100, 18),
		BackgroundColor3 = GREY,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = FONT,
		TextSize = 10,
		TextColor3 = BLACK,
		TextXAlignment = LEFT,
		TextTruncate = TRUNC,
		Text = "",
	}, taskList)
	tr(tb, key)

	local win = { frame = f, bar = bar, body = body, tb = tb, min = false, onClose = onClose, W = w, H = h, pos = f.Position, box = f }
	table.insert(wins, win)
	dragWin(win, bar)
	minB.MouseButton1Click:Connect(function()
		minimize(win)
	end)
	closeB.MouseButton1Click:Connect(function()
		closeWin(win)
	end)
	tb.MouseButton1Click:Connect(function()
		if win.min or active ~= win then
			focus(win)
		else
			minimize(win)
		end
	end)
	layoutWin(win)
	focus(win)
	return win
end

