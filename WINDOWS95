local wins, active, zTop = {}, nil, 10
local TICKS = {}

local function onTick(w, fn)
	table.insert(TICKS, { w = w, fn = fn })
end

local function inside(o, p)
	local a, s = o.AbsolutePosition, o.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

local function styleTb(w, sunken)
	w.tb:ClearAllChildren()
	bevel(w.tb, sunken)
end

local function focus(w)
	if w.min then
		w.min = false
		w.frame.Visible = true
	end
	zTop = zTop + 1
	w.frame.ZIndex = zTop
	for _, o in ipairs(wins) do
		if o ~= w then
			o.bar.BackgroundColor3 = DGREY
			styleTb(o, false)
		end
	end
	w.bar.BackgroundColor3 = NAVY
	styleTb(w, true)
	active = w
end

local function minimize(w)
	w.min = true
	w.frame.Visible = false
	styleTb(w, false)
	if active == w then
		active = nil
	end
end

local function closeWin(w)
	sfx(SND.click, 0.3)
	if w.onClose then
		pcall(w.onClose)
	end
	w.frame:Destroy()
	w.tb:Destroy()
	for i, o in ipairs(wins) do
		if o == w then
			table.remove(wins, i)
			break
		end
	end
	if active == w then
		active = nil
	end
end

local function fullArea()
	local vs = viewport()
	return vs.X, vs.Y - TASKBAR_H
end

local function layoutWin(w)
	local aw, ah = fullArea()
	local bw, bh = w.W - 8, w.H - 29
	if S.outside then
		w.frame.Size = UDim2.fromOffset(w.W, w.H)
		w.frame.Position = w.pos
		w.frame.BackgroundTransparency = 0
		w.body.Position = UDim2.fromOffset(4, 25)
		w.box = w.frame
	else
		w.frame.Size = UDim2.fromOffset(aw, ah)
		w.frame.Position = UDim2.fromOffset(0, 0)
		w.frame.BackgroundTransparency = 1
		w.body.Position = UDim2.fromOffset(math.floor((aw - bw) / 2), 25 + math.floor((ah - 25 - bh) / 2))
		w.box = w.body
	end
	w.body.Size = UDim2.fromOffset(bw, bh)
end

local function applyMode()
	for _, w in ipairs(wins) do
		layoutWin(w)
	end
end

local function dragWin(w, handle)
	handle.Active = true
	local dragging, startMouse, startPos = false, nil, nil
	handle.InputBegan:Connect(function(i)
		if isClick(i) and S.outside then
			dragging = true
			startMouse = i.Position
			startPos = w.frame.Position
		end
	end)
	track(UIS.InputChanged:Connect(function(i)
		if dragging and isMove(i) then
			local d = i.Position - startMouse
			w.pos = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
			w.frame.Position = w.pos
		end
	end))
	track(UIS.InputEnded:Connect(function(i)
		if isClick(i) then
			dragging = false
		end
	end))
end

