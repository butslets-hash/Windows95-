			{ id = "audio", title = "Áudio", names = { "áudio", "audio" }, open = openAudio },
		}
		local function findScript(cmd)
			local low = cmd:lower()
			for _, s in ipairs(SCRIPTS) do
				for _, n in ipairs(s.names) do
					if n == low then
						return s
					end
				end
			end
			return nil
		end

		local busy = false
		local function loadScript(s)
			busy = true
			box.TextEditable = false
			out(T("termLoading") .. s.title .. "...")
			out("")
			local idx = #lines
			task.spawn(function()
				local pct = 0
				while pct < 100 do
					pct = math.min(100, pct + 5)
					local filled = math.floor(pct / 100 * 16)
					lines[idx] = string.format("[%s%s] %3d%%", string.rep("#", filled), string.rep(".", 16 - filled), pct)
					log.Text = table.concat(lines, "\n")
					task.wait(0.04)
				end
				out(T("termOk"))
				local ok, err = pcall(s.open)
				if not ok then
					out(T("err") .. ": " .. tostring(err))
				end
				busy = false
				box.TextEditable = true
			end)
		end

		box.FocusLost:Connect(function(enter)
			if not enter or busy then
				return
			end
			local cmd = box.Text:match("^%s*(.-)%s*$") or ""
			box.Text = ""
			sfx(SND.click, 0.2)
			local low = cmd:lower()
			if cmd == "" then
			elseif low == "help" or low == "ajuda" then
				out(T("termHelp"))
				out(T("termHelp2"))
			elseif low == "clear" or low == "limpar" then
				lines = {}
				log.Text = ""
			else
				local s = findScript(cmd)
				if not s then
					out(T("termNotFound") .. cmd)
				elseif OPEN[s.id] then
					out(s.title .. T("termOpen"))
				else
					loadScript(s)
				end
			end
			task.defer(function()
				if not busy and box.Parent then
					box:CaptureFocus()
				end
			end)
		end)
	end

