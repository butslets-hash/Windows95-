			for snd in pairs(tracked) do
				if snd.IsPlaying and snd.SoundId ~= "" and snd:IsDescendantOf(workspace) then
					local pos = soundPos(snd)
					if pos and (pos - root.Position).Magnitude <= scanR then
						local owner = ownerOf(snd)
						if owner ~= LP then
							addDetected(snd, owner)
						end
					end
				end
			end
		end

