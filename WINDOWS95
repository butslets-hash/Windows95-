		local function isDouble(key)
			local now = os.clock()
			local d = lastKey == key and now - lastTime < 0.4
			lastKey, lastTime = key, now
			return d
		end

		local function flipTop(list)
			local top = list[#list]
			if top and not top.up then
				top.up = true
			end
		end

		local function selCards()
			if not sel then
				return nil
			end
			if sel.kind == "waste" then
				local c = waste[#waste]
				return c and { c } or nil
			end
			local list = cols[sel.col]
			if not list[sel.idx] or not list[sel.idx].up then
				return nil
			end
			local out = {}
			for k = sel.idx, #list do
				table.insert(out, list[k])
			end
			return out
		end

		local function removeSel(n)
			if sel.kind == "waste" then
				table.remove(waste)
				return
			end
			local list = cols[sel.col]
			for _ = 1, n do
				table.remove(list)
			end
			flipTop(list)
		end

		local function toCol(c)
			local cards = selCards()
			if not cards or (sel.kind == "tab" and sel.col == c) then
				return false
			end
			local dest, first = cols[c], cards[1]
			local ok
			if #dest == 0 then
				ok = first.r == 13
			else
				local top = dest[#dest]
				ok = top.up and top.r == first.r + 1 and isRed(top) ~= isRed(first)
			end
			if not ok then
				return false
			end
			removeSel(#cards)
			for _, cd in ipairs(cards) do
				table.insert(dest, cd)
			end
			sel = nil
			return true
		end

		local function toFound(s)
			local cards = selCards()
			if not cards or #cards ~= 1 then
				return false
			end
			local cd = cards[1]
			if cd.s ~= s or cd.r ~= #found[s] + 1 then
				return false
			end
			removeSel(1)
			table.insert(found[s], cd)
			sel = nil
			return true
		end

