	local function setOn(b, on, text)
		b.Text = text
		b.BackgroundColor3 = on and NAVY or GREY
		b.TextColor3 = on and WHITE or BLACK
	end

	local function paintOn(b, on)
		b.BackgroundColor3 = on and NAVY or GREY
		b.TextColor3 = on and WHITE or BLACK
	end

	local function rangeSlider(parent, x, y, w, mn, mx, step, initial, onChange)
		local last = nil
		slider(parent, x, y, w, (initial - mn) / (mx - mn), function(f)
			local v = mn + math.floor(f * (mx - mn) / step + 0.5) * step
			if v ~= last then
				last = v
				onChange(v)
			end
		end)
	end

	local function keyValid(s)
		return #s >= 25 and s:sub(1, 3) == "sk-" and not s:find("%s")
	end

	local function clean(t)
		return (t:gsub("%*%*", ""):gsub("#+ ", ""))
	end

	local function cut(s, n)
		local len = utf8.len(s)
		if len and len > n then
			return s:sub(1, utf8.offset(s, n + 1) - 1)
		end
		return s
	end

