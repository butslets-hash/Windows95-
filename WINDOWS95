			trackSound(d)
		end
		table.insert(cs, workspace.DescendantAdded:Connect(trackSound))
		table.insert(cs, workspace.DescendantRemoving:Connect(function(d)
			tracked[d] = nil
		end))
		table.insert(cs, preview.Ended:Connect(function()
