end

local function field(parent, x, y, w, h)
	local f = make("Frame", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, parent)
	bevel(f, true)
	return f
end

local function slider(parent, x, y, w, value, onChange)
	local track_ = make("Frame", {
		Position = UDim2.fromOffset(x, y + 4),
		Size = UDim2.fromOffset(w, 6),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, parent)
	bevel(track_, true)
	local fill = make("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = NAVY, BorderSizePixel = 0 }, track_)
	local knob = make("Frame", {
		Size = UDim2.fromOffset(8, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = GREY,
		BorderSizePixel = 0,
	}, track_)
	bevel(knob, false)
	local hit = make("TextButton", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, 14),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, parent)

	local obj = {}
	local function set(v, fire)
		v = math.clamp(v, 0, 1)
		fill.Size = UDim2.new(v, 0, 1, 0)
		knob.Position = UDim2.new(v, 0, 0.5, 0)
		if fire and onChange then
			onChange(v)
		end
	end
	function obj.set(v)
		set(v, false)
	end

	local dragging = false
	local function fromX(px)
		set((px - track_.AbsolutePosition.X) / track_.AbsoluteSize.X, true)
	end
	hit.InputBegan:Connect(function(i)
		if isClick(i) then
			dragging = true
			fromX(i.Position.X)
		end
	end)
	track(UIS.InputChanged:Connect(function(i)
		if dragging and isMove(i) then
			fromX(i.Position.X)
		end
	end))
	track(UIS.InputEnded:Connect(function(i)
		if isClick(i) then
			dragging = false
		end
	end))
	set(value, false)
	return obj
end

