	local function askAI(messages, cb, sysPrompt)
		if not httpRequest then
			return cb(nil, T("noRequest"))
		end
		if not keyValid(CB.key) then
			return cb(nil, T("noKey"))
		end
		local done = false
		local function finish(text, err)
			if done then
				return
			end
			done = true
			cb(text, err)
		end
		task.delay(TIMEOUT, function()
			finish(nil, T("timeoutMsg"))
		end)

		local mode = CB.mode or "medio"
		local instructions = sysPrompt
		if not instructions then
			instructions = "You are a friendly AI assistant inside a Roblox game menu. Chat naturally and give game tips when asked. Always reply in "
				.. LANGNAME[S.lang] .. ".\n\n" .. RULES[S.lang][mode]
		end

		task.spawn(function()
			local ok, res = pcall(httpRequest, {
				Url = MODEL_URL,
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json",
					["Authorization"] = "Bearer " .. CB.key,
				},
				Body = HttpService:JSONEncode({
					model = MODEL_NAME,
					instructions = instructions,
					input = messages,
					max_output_tokens = TOKENS[mode],
					store = false,
				}),
			})
			if not ok or type(res) ~= "table" then
				return finish(nil, tostring(res))
			end
			local okj, data = pcall(HttpService.JSONDecode, HttpService, res.Body or "")
			if not okj or type(data) ~= "table" then
				return finish(nil, "HTTP " .. tostring(res.StatusCode))
			end
			if data.error then
				local emsg = type(data.error) == "table" and data.error.message or data.error
				return finish(nil, "API: " .. tostring(emsg))
			end
			local out = {}
			if type(data.output) == "table" then
				for _, item in ipairs(data.output) do
					if item.type == "message" and type(item.content) == "table" then
						for _, c in ipairs(item.content) do
							if c.type == "output_text" and type(c.text) == "string" then
								table.insert(out, c.text)
							end
						end
					end
				end
			end
			local text = table.concat(out)
			if text == "" and type(data.output_text) == "string" then
				text = data.output_text
			end
			if text == "" then
				return finish(nil, T("noReply") .. " (" .. tostring(data.status or "?") .. ")")
			end
			finish(text)
		end)
	end

	local function speakText(text, cb)
		if not (writefile and getcustomasset and httpRequest) then
			return cb(nil, T("voiceErr"))
		end
		if not keyValid(CB.key) then
			return cb(nil, T("noKey"))
		end
		task.spawn(function()
			local ok, res = pcall(httpRequest, {
				Url = TTS_URL,
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json",
					["Authorization"] = "Bearer " .. CB.key,
				},
				Body = HttpService:JSONEncode({
					model = TTS_MODEL,
					input = cut(text, 3000),
					voice = VOICES[CB.voice],
					response_format = "mp3",
				}),
			})
			if not ok or type(res) ~= "table" then
				return cb(nil, tostring(res))
			end
			if res.StatusCode ~= 200 or not res.Body then
				return cb(nil, "TTS HTTP " .. tostring(res.StatusCode))
			end
			voiceCount = voiceCount + 1
			local fname = "chatbot_voz_" .. voiceCount .. ".mp3"
			if not pcall(writefile, fname, res.Body) then
				return cb(nil, T("voiceErr"))
			end
			local okA, asset = pcall(getcustomasset, fname)
			if not okA then
				return cb(nil, T("voiceErr"))
			end
			cb(asset)
		end)
	end

