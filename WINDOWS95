			if not enabled or os.clock() < cdEnd then
				return
			end
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local p = Vector2.new(input.Position.X, input.Position.Y)
			for _, win in ipairs(wins) do
				if not win.min and inside(win.box, p) then
					return
				end
			end
			if inside(taskbar, p) then
				return
			end
			local ray = workspace.CurrentCamera:ScreenPointToRay(p.X, p.Y)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			local char = LP.Character
			params.FilterDescendantsInstances = char and { char } or {}
			local result = workspace:Raycast(ray.Origin, ray.Direction * MAX_DIST, params)
			if result and teleportMap(result.Position, result.Normal) then
				cdEnd = os.clock() + COOLDOWN
			end
		end)
		paintT()
	end

