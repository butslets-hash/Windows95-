local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function bevel(f, sunken)
	local a, b, c, d = WHITE, BLACK, GREY, DGREY
	if sunken then
		a, b, c, d = DGREY, WHITE, BLACK, GREY
	end
	local function edge(pos, size, col)
		make("Frame", { Position = pos, Size = size, BackgroundColor3 = col, BorderSizePixel = 0 }, f)
	end
	edge(UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 1), a)
	edge(UDim2.fromOffset(0, 0), UDim2.new(0, 1, 1, 0), a)
	edge(UDim2.new(0, 0, 1, -1), UDim2.new(1, 0, 0, 1), b)
	edge(UDim2.new(1, -1, 0, 0), UDim2.new(0, 1, 1, 0), b)
	edge(UDim2.fromOffset(1, 1), UDim2.new(1, -2, 0, 1), c)
	edge(UDim2.fromOffset(1, 1), UDim2.new(0, 1, 1, -2), c)
	edge(UDim2.new(0, 1, 1, -2), UDim2.new(1, -2, 0, 1), d)
	edge(UDim2.new(1, -2, 0, 1), UDim2.new(0, 1, 1, -2), d)
end

local function btn(parent, text, x, y, w, h, key)
	local b = make("TextButton", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h or 22),
		BackgroundColor3 = GREY,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = FONT,
		TextSize = 11,
		TextColor3 = BLACK,
		Text = text or "",
	}, parent)
	bevel(b, false)
	b.MouseButton1Click:Connect(function()
		sfx(SND.click, 0.3)
	end)
	if key then
		tr(b, key)
	end
	return b
end

