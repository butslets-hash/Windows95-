	local function go()
		local url = addrBox.Text:match("^%s*(.-)%s*$") or ""
		if url == "" then
			return
		end
		if not url:match("^https?://") then
			url = "https://" .. url
		end
		if not httpRequest then
			content.Text = T("noRequest")
			sfx(SND.err)
			return
		end
		content.Text = T("loading")
		sf.CanvasPosition = Vector2.zero
		task.spawn(function()
			local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
			if not ok or type(res) ~= "table" then
				content.Text = T("err") .. ": " .. tostring(res)
				sfx(SND.err)
				return
			end
			local html = res.Body or ""
			local txt = html:gsub("<script.-</script>", " "):gsub("<style.-</style>", " "):gsub("<[^>]+>", " "):gsub("&nbsp;", " "):gsub("&amp;", "&"):gsub("%s+", " ")
			local n = utf8.len(txt)
			if n and n > 3000 then
				txt = txt:sub(1, utf8.offset(txt, 3001) - 1) .. " ..."
			end
			content.Text = txt
		end)
	end

	btn(body, "", 242, 0, 46, 22, "go").MouseButton1Click:Connect(go)
	addrBox.FocusLost:Connect(function(enter)
		if enter then
			go()
		end
	end)
end

